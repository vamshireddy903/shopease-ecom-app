# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Amazon RDS MySQL connection ----
# Point these at your existing RDS instance
DB_HOST=your-db-instance.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_rds_password
DB_NAME=ecommerce

# Frontend origin allowed for CORS
CLIENT_ORIGIN=http://localhost:3000
